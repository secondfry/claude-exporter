{
  "name": "claude-exporter",
  "version": "1.20.0",
  "private": true,
  "type": "module",
  "description": "Export conversations and artifacts from Claude.ai",
  "scripts": {
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "dev": "vite build --mode chrome --watch",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "npm run format:eslint && npm run format:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "sign:firefox": "npm run build:firefox && web-ext sign --source-dir dist/firefox --artifacts-dir releases/signed --channel unlisted",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0"
  }
}
